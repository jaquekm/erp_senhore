<h1 class="h3 mb-3">Editar usuário · <%= @account.company_name %></h1>

<div class="card" style="max-width: 480px;">
  <div class="card-body">
    <% if @user.errors.any? %>
      <div class="alert alert-danger"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= form_with model: @user, url: admin_account_user_path(@account, @user), method: :patch, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :first_name, 'Nome', class: 'form-label' %>
        <%= f.text_field :first_name, class: 'form-control' %>
      </div>
      <div class="mb-3">
        <%= f.label :last_name, 'Sobrenome', class: 'form-label' %>
        <%= f.text_field :last_name, class: 'form-control' %>
      </div>
      <div class="mb-3">
        <%= f.label :email, class: 'form-label' %>
        <%= f.email_field :email, class: 'form-control', required: true %>
      </div>
      <div class="mb-3">
        <%= f.label :password, 'Nova senha (deixe em branco para manter)', class: 'form-label' %>
        <%= f.password_field :password, class: 'form-control', minlength: 6 %>
      </div>
      <% unless @user.owner? %>
        <div class="mb-3 form-check">
          <%= f.check_box :active, class: 'form-check-input' %>
          <%= f.label :active, 'Acesso ativo', class: 'form-check-label' %>
        </div>
      <% end %>

      <%= f.submit 'Salvar', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', admin_account_path(@account), class: 'btn btn-link' %>
    <% end %>
  </div>
</div>
