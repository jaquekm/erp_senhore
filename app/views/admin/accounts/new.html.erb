<h1 class="h3 mb-3">Nova conta de cliente</h1>

<div class="card" style="max-width: 560px;">
  <div class="card-body">
    <%= form_with model: @account, url: admin_accounts_path, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :company_name, 'Nome da empresa', class: 'form-label' %>
        <%= f.text_field :company_name, class: 'form-control', required: true %>
      </div>

      <hr>
      <p class="text-muted small">Login do titular da conta (quem primeiro acessa o sistema)</p>

      <div class="mb-3">
        <%= f.label :owner_email, 'E-mail', class: 'form-label' %>
        <%= f.email_field :owner_email, class: 'form-control', required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :owner_password, 'Senha', class: 'form-label' %>
        <%= f.password_field :owner_password, class: 'form-control', required: true, minlength: 6 %>
      </div>

      <hr>
      <p class="text-muted small">Limites de uso</p>

      <div class="row">
        <div class="col mb-3">
          <%= f.label :max_users, 'Quantidade de usuários (logins)', class: 'form-label' %>
          <%= f.number_field :max_users, value: 1, min: 1, class: 'form-control' %>
        </div>
        <div class="col mb-3">
          <%= f.label :max_concurrent_sessions, 'Usuários simultâneos', class: 'form-label' %>
          <%= f.number_field :max_concurrent_sessions, value: 1, min: 1, class: 'form-control' %>
        </div>
      </div>

      <%= f.submit 'Criar conta', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', admin_accounts_path, class: 'btn btn-link' %>
    <% end %>
  </div>
</div>
