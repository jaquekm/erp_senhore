<h1 class="h3 mb-3">Editar limites da conta</h1>

<div class="card" style="max-width: 560px;">
  <div class="card-body">
    <%= form_with model: @account, url: admin_account_path(@account), method: :patch, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :company_name, 'Nome da empresa', class: 'form-label' %>
        <%= f.text_field :company_name, class: 'form-control', required: true %>
      </div>

      <div class="row">
        <div class="col mb-3">
          <%= f.label :max_users, 'Quantidade de usuários (logins)', class: 'form-label' %>
          <%= f.number_field :max_users, min: 1, class: 'form-control' %>
        </div>
        <div class="col mb-3">
          <%= f.label :max_concurrent_sessions, 'Usuários simultâneos', class: 'form-label' %>
          <%= f.number_field :max_concurrent_sessions, min: 1, class: 'form-control' %>
        </div>
      </div>

      <%= f.submit 'Salvar', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', admin_account_path(@account), class: 'btn btn-link' %>
    <% end %>
  </div>
</div>
