<% link_extra = turbo_frame.present? ? "data-turbo-frame='#{turbo_frame}'" : '' %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
  <%== pagy_bootstrap_nav(pagy, link_extra: link_extra) %>

  <%= form_tag request.path, method: :get, class: 'd-flex align-items-center gap-2 mb-0' do %>
    <% request.query_parameters.except('items', 'page').each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <%= label_tag :pagy_items, 'Itens por página', class: 'mb-0 text-muted small text-nowrap' %>
    <%= select_tag :items, options_for_select([10, 20, 50, 100], pagy.vars[:items]),
        id: 'pagy_items', class: 'form-select form-select-sm', style: 'width: auto;',
        onchange: 'this.form.submit()' %>
  <% end %>
</div>
